    -- MOB FINDER & POSITION LOCK
    local function getEnemyCFrame(mobModel)
        if not mobModel or not mobModel:IsA("Model") then return nil end
        if mobModel.PrimaryPart then return mobModel.PrimaryPart.CFrame end

        local root = mobModel:FindFirstChild("HumanoidRootPart", true)
            or mobModel:FindFirstChild("Torso", true)
            or mobModel:FindFirstChild("UpperTorso", true)
            or mobModel:FindFirstChild("Root", true)
            or mobModel:FindFirstChild("Hitbox", true)

        if root and root:IsA("BasePart") then return root.CFrame end

        local success, pivot = pcall(function() return mobModel:GetPivot() end)
        if success and pivot then return pivot end

        for _, descendant in ipairs(mobModel:GetDescendants()) do
            if descendant:IsA("BasePart") then return descendant.CFrame end
        end
        return nil
    end

    local function getClosestEnemy()
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return nil, nil end

        local myPos = character.HumanoidRootPart.Position
        local enemyFolder = workspace:FindFirstChild("EnemyNpc")

        if enemyFolder and #enemyFolder:GetChildren() > 0 then
            local closestMob = nil
            local closestCFrame = nil
            local shortestDistance = math.huge

            for _, mobModel in ipairs(enemyFolder:GetChildren()) do
                if mobModel:IsA("Model") and mobModel ~= character then
                    local humanoid = mobModel:FindFirstChildOfClass("Humanoid") or mobModel:FindFirstChild("Humanoid", true)
                    if not humanoid or humanoid.Health > 0 then
                        local mobCF = getEnemyCFrame(mobModel)
                        if mobCF then
                            local dist = (myPos - mobCF.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                closestMob = mobModel
                                closestCFrame = mobCF
                            end
                        end
                    end
                end
            end
            if closestMob then return closestMob, closestCFrame end
        end
        return nil, nil
    end

    -- Position Locking Loop with Below-Ground Hover Fallback
    RunService.Heartbeat:Connect(function()
        if not FarmSettings.AutoFarm then return end

        local character = LocalPlayer.Character
        if not character then return end

        local myHRP = character:FindFirstChild("HumanoidRootPart")
        local myHumanoid = character:FindFirstChildOfClass("Humanoid")
        if not myHRP or not myHumanoid or myHumanoid.Health <= 0 then return end

        local target, targetCF = getClosestEnemy()
        FarmSettings.CurrentTarget = target

        -- Disable collision on character parts to prevent getting caught in terrain
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        if target and targetCF then
            local distance = FarmSettings.Distance
            local farmCF

            if FarmSettings.FarmPosition == "Below" then
                farmCF = targetCF * CFrame.new(0, -distance, 0) * CFrame.Angles(math.rad(90), 0, 0)
            else
                farmCF = targetCF * CFrame.new(0, distance, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            end

            -- Apply position and save as the active hover position
            myHRP.CFrame = farmCF
            lastHoverPosition = farmCF
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        elseif lastHoverPosition then
            -- Fallback: Hold position floating in place if no enemies are currently active
            myHRP.CFrame = lastHoverPosition
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end
    end)

