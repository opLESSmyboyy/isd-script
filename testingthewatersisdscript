local function castSkillRemote(skillName, stepsCount)
    pcall(function()
        if PlayerActionRE then
            for i = 1, stepsCount do
                PlayerActionRE:FireServer("SkillAction", skillName, i)
                task.wait(0.01)
            end
            PlayerActionRE:FireServer("SkillAction", skillName, nil)
        end
    end)
end

