local function suppressEnergyWarnings(guiContainer)
    if not guiContainer then return end
    guiContainer.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("TextLabel") or descendant:IsA("TextBox") then
            local text = descendant.Text:lower()
            if text:find("not enough energy") or text:find("energy") or text:find("mana") 
            or text:find("action too frequent") or text:find("frequent") or text:find("slow down") or text:find("wait")
            or text:find("cant switch") or text:find("can't switch") or text:find("cannot switch") then
                descendant.Visible = false
                pcall(function() descendant:Destroy() end)
            end
        end
    end)
end

if LocalPlayer:FindFirstChild("PlayerGui") then
    suppressEnergyWarnings(LocalPlayer.PlayerGui)
