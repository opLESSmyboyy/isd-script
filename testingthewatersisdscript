        local isOpen = false

        local function refreshDropdownOptions()
            for _, child in ipairs(optionContainer:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end

            local options = optionsProvider()
            local maxDisplayHeight = math.min(#options * 24, 120)
            optionContainer.CanvasSize = UDim2.new(0, 0, 0, #options * 24)
            optionContainer.Size = UDim2.new(0, 140, 0, maxDisplayHeight)

            for _, optText in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, 24)
                optBtn.BackgroundTransparency = 1
                optBtn.Text = "  " .. optText
                optBtn.TextColor3 = Color3.fromRGB(180, 170, 165)
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextSize = 10
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.ZIndex = 21
                optBtn.Parent = optionContainer

                optBtn.MouseButton1Click:Connect(function()
                    dropBtn.Text = "  " .. optText
                    isOpen = false
                    row.Size = UDim2.new(1, -6, 0, 42)
                    optionContainer.Visible = false
                    arrowIcon.Text = "⌃"
                    if callback then callback(optText) end
                end)
            end
        end

        dropBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            if isOpen then
                refreshDropdownOptions()
                local options = optionsProvider()
                local maxDisplayHeight = math.min(#options * 24, 120)
                row.Size = UDim2.new(1, -6, 0, 42 + maxDisplayHeight + 6)
                optionContainer.Visible = true
                arrowIcon.Text = "⌄"
            else
                row.Size = UDim2.new(1, -6, 0, 42)
                optionContainer.Visible = false
                arrowIcon.Text = "⌃"
            end
        end)

        return { Refresh = refreshDropdownOptions }
    end

