local activeTabBtn = nil

local function addTab(name, iconText, subTitleText)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, -12, 0, 32)
    tabBtn.BackgroundColor3 = Color3.fromRGB(44, 32, 30)
    tabBtn.BackgroundTransparency = 0.6
    tabBtn.Text = ""
    tabBtn.Name = name
    tabBtn.Parent = tabList

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 6)
    tabCorner.Parent = tabBtn

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 16)
    indicator.Position = UDim2.new(0, 2, 0.5, -8)
    indicator.BackgroundColor3 = Color3.fromRGB(215, 95, 50)
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.Parent = tabBtn

    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = indicator

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -24, 1, 0)
    label.Position = UDim2.new(0, 22, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = iconText .. "  " .. name
    label.TextColor3 = Color3.fromRGB(170, 155, 150)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = tabBtn

    tabBtn.MouseButton1Click:Connect(function()
        if activeTabBtn and activeTabBtn ~= tabBtn then
            activeTabBtn.BackgroundTransparency = 0.6
            local prevInd = activeTabBtn:FindFirstChildOfClass("Frame")
            if prevInd then prevInd.Visible = false end
            local prevLbl = activeTabBtn:FindFirstChildOfClass("TextLabel")
            if prevLbl then prevLbl.TextColor3 = Color3.fromRGB(170, 155, 150) end

            if pages[activeTabBtn.Name] then
                pages[activeTabBtn.Name].Visible = false
            end
        end

        activeTabBtn = tabBtn
        tabBtn.BackgroundTransparency = 0.2
        indicator.Visible = true
        label.TextColor3 = Color3.fromRGB(240, 230, 225)
        
        headerTitle.Text = name
        subTitle.Text = subTitleText or "Category"

        if pages[name] then
            pages[name].Visible = true
        end
    end)

    return tabBtn
end

