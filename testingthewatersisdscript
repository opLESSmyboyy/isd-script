                    local wakeFolder = workspace:FindFirstChild("RoundWakeTouch") or (workspace:FindFirstChild("WorldEnemys") and workspace.WorldEnemys:FindFirstChild("RoundWakeTouch"))

                    local round2InWave = waveFolder and waveFolder:FindFirstChild("Round2")
                    local round2InWake = wakeFolder and wakeFolder:FindFirstChild("Round2")
                    local round3InWave = waveFolder and waveFolder:FindFirstChild("Round3")
