local function triggerExitPortal()
    pcall(function()
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end

        local myHRP = character.HumanoidRootPart
        local myPos = myHRP.Position
        
        local bestPortalRoot = nil
        local bestPortalRF = nil
        local shortestDistance = math.huge

        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Portal" and obj:IsA("Model") then
                local root = obj:FindFirstChild("Root") or obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                if root then
                    local rf = root:FindFirstChild("RF") or obj:FindFirstChild("RF", true)
                    local dist = (myPos - root.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        bestPortalRoot = root
                        bestPortalRF = rf
                    end
                end
            end
        end

        if bestPortalRoot then
            visitedCheckpoints = {}

            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
            myHRP.CFrame = bestPortalRoot.CFrame * CFrame.new(0, 3, 0)
            
            pcall(function()
                firetouchinterest(myHRP, bestPortalRoot, 0)
                task.wait(0.05)
                firetouchinterest(myHRP, bestPortalRoot, 1)
            end)

            task.wait(0.2)

            if bestPortalRF and bestPortalRF:IsA("RemoteFunction") then
                pcall(function() bestPortalRF:InvokeServer("AdvanceIsland") end)
                pcall(function() bestPortalRF:InvokeServer() end)
            end
        end
    end)
end

