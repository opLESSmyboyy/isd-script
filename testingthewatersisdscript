        isListening = true
        keyBtn.Text = "..."
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if isListening and input.UserInputType == Enum.UserInputType.Keyboard then
            isListening = false
            currentKeyEnum = input.KeyCode
            keyBtn.Text = input.KeyCode.Name
        elseif not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKeyEnum then
            toggleUI()
        end
    end)
end

