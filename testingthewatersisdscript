-- DIRECT CHECKPOINT & MOB BRIDGE ENGINE
-- ===================================================

local function getOrderedTouchParts()
    local worldEnemys = workspace:FindFirstChild("WorldEnemys")
    if not worldEnemys then return {} end

    local touchFolder = worldEnemys:FindFirstChild("RoundWakeTouch") 
        or worldEnemys:FindFirstChild("WaveSpawnTouch")
    
    if not touchFolder then return {} end

    local parts = {}
    for _, part in ipairs(touchFolder:GetChildren()) do
        if part:IsA("BasePart") then
            table.insert(parts, part)
        end
    end

    table.sort(parts, function(a, b)
        local numA = tonumber(a.Name:match("%d+")) or 0
        local numB = tonumber(b.Name:match("%d+")) or 0
        return numA < numB
    end)

    return parts
end

task.spawn(function()
    while true do
        task.wait(0.3)

        if FarmSettings.AutoFarm and not isProcessingCheckpoint then
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local myHRP = character.HumanoidRootPart
                
                if (myHRP.Position - lastIslandCheckPosition).Magnitude > 1000 then
                    visitedCheckpoints = {}
                    lastIslandCheckPosition = myHRP.Position
                end

                local activeTarget = getClosestEnemy()
                FarmSettings.CurrentTarget = activeTarget

                if activeTarget then
                    task.wait(0.1)
                else
                    isProcessingCheckpoint = true
                    
                    local touchParts = getOrderedTouchParts()
                    local untouchedPart = nil

                    for _, part in ipairs(touchParts) do
                        local posId = string.format("%s_%.1f_%.1f", part.Name, part.Position.X, part.Position.Z)
                        if not visitedCheckpoints[posId] then
                            untouchedPart = part
                            visitedCheckpoints[posId] = posId
                            break
                        end
                    end

                    if untouchedPart then
                        myHRP.AssemblyLinearVelocity = Vector3.zero
                        myHRP.CFrame = untouchedPart.CFrame * CFrame.new(0, 2, 0)
                        lastHoverPosition = myHRP.CFrame
                        
                        pcall(function()
                            firetouchinterest(myHRP, untouchedPart, 0)
                            task.wait(0.05)
                            firetouchinterest(myHRP, untouchedPart, 1)
                        end)

                        task.wait(1.0)
                    else
                        visitedCheckpoints = {}
                        triggerExitPortal()
                        task.wait(1.5)
                    end

                    isProcessingCheckpoint = false
                end
            end
        end
    end
end)

